# Copiar a .env (cp .env.example .env). docker compose también lee este archivo.
PORT=4003

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Latencia simulada del proveedor externo de precios (no cambiar para la entrega).
PROVEEDOR_LATENCIA_MS=1500

# Caché de precios
CACHE_TTL_SEGUNDOS=60

# Límite de peticiones por cliente (header x-api-key)
RATE_LIMIT_MAX=10
RATE_LIMIT_VENTANA_SEGUNDOS=60
